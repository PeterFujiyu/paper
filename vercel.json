{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://hcaptcha.com https://*.hcaptcha.com; font-src 'self' https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'none'; frame-src https://hcaptcha.com https://*.hcaptcha.com; img-src 'self' data: https:; object-src 'none'; script-src 'self' https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://hcaptcha.com https://*.hcaptcha.com; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/auth-login", "destination": "/api/auth?route=auth-login" },
    { "source": "/api/auth-logout", "destination": "/api/auth?route=auth-logout" },
    { "source": "/api/auth-me", "destination": "/api/auth?route=auth-me" },
    { "source": "/api/auth-register", "destination": "/api/auth?route=auth-register" },

    { "source": "/api/admin-brews", "destination": "/api/admin?route=admin-brews" },
    { "source": "/api/admin-notes", "destination": "/api/admin?route=admin-notes" },
    { "source": "/api/admin-post", "destination": "/api/admin?route=admin-post" },
    { "source": "/api/admin-posts", "destination": "/api/admin?route=admin-posts" },
    { "source": "/api/slug-check", "destination": "/api/admin?route=slug-check" },

    { "source": "/api/brew", "destination": "/api/content?route=brew" },
    { "source": "/api/brews", "destination": "/api/content?route=brews" },
    { "source": "/api/note", "destination": "/api/content?route=note" },
    { "source": "/api/notes", "destination": "/api/content?route=notes" },
    { "source": "/api/post", "destination": "/api/content?route=post" },
    { "source": "/api/posts", "destination": "/api/content?route=posts" },

    { "source": "/api/post-completion", "destination": "/api/metrics?route=post-completion" },
    { "source": "/api/post-view", "destination": "/api/metrics?route=post-view" },

    { "source": "/api/post-shell", "destination": "/api/shell?route=post-shell" },

    {
      "source": "/writing/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Pinterest|redditbot|Applebot|Embedly|Iframely|SkypeUriPreview|vkShare|Mastodon).*"
        }
      ],
      "destination": "/api/shell?route=post-shell&slug=:slug"
    },

    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
